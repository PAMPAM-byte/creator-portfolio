# Public site URL — used for sitemap, canonical URLs, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form ──────────────────────────────────────────────
# Pick ONE provider. Leave the other blank.
# API keys stay on the server. Never prefix them with NEXT_PUBLIC_.

# Option A — Formspree (https://formspree.io)
# Create a form, then paste the id from https://formspree.io/f/<id>
FORMSPREE_FORM_ID=

# Option B — Resend (https://resend.com)
# Create an API key and a verified from-address.
RESEND_API_KEY=
RESEND_FROM_EMAIL="PAMPAM <hello@yourdomain.com>"
CONTACT_TO_EMAIL=your-email@example.com
